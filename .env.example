# ─────────────────────────────────────────────────────────────
# ServiceLink — SERVER environment template
# Copy this file to .env and fill in the values for your environment.
# Never commit .env (only this .example file).
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MySQL ─────────────────────────────────────
# Local dev defaults shown. Override for staging / prod.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=servicelink
DB_USER=root
DB_PASSWORD=

# ── CORS / client origin ──────────────────────
# Used for CORS allow-list AND for building absolute portal links
# (e.g. impersonation magic links emailed to admins).
CLIENT_URL=http://localhost:5173

# ── Firebase Admin SDK ────────────────────────
# Download from: Firebase Console → Project Settings
#   → Service Accounts → Generate new private key
# Save the file outside the repo or in repo root (gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Google Maps (server-side reverse-geocoding + place search) ──
# Required APIs to enable on Google Cloud Console:
#   - Geocoding API   (lat/lng → address)
#   - Places API      (place autocomplete for "Change location" typeahead)
# Without Places API, typeahead falls back to Photon (free, fuzzy).
# For production: restrict this key to your server's IP.
GOOGLE_MAPS_API_KEY=

# ── Razorpay ──────────────────────────────────
# KEY_ID is safe to expose to the client (checkout needs it).
# KEY_SECRET must NEVER leave the server — used only for:
#   1. Creating orders server-side via the Razorpay API
#   2. HMAC-SHA256 signature verification on payment callbacks
# Rotate via Razorpay dashboard if leaked.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# ── Admin impersonation (H90) ─────────────────
# HMAC secret used to sign read-only impersonation tokens issued by
# admins from the portal "view as user" action. ROTATE periodically —
# any leak lets the holder forge a read-only session for any user.
# Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
IMPERSONATE_SECRET=

# ── External APIs (overrides for self-hosted mirrors) ─────────
# Identifying User-Agent sent to upstream APIs that require one
# (Nominatim policy especially). MUST be unique per deployment —
# Nominatim will rate-limit / block forks reusing the same string.
UPSTREAM_UA=ServiceLink/1.0 (https://your-domain.example; ops@your-domain.example)

# Photon (komoot) — fuzzy place search + reverse geocode.
# Only override if you self-host for quota reasons.
PHOTON_ENDPOINT=https://photon.komoot.io/api/
PHOTON_REVERSE_ENDPOINT=https://photon.komoot.io/reverse

# Nominatim (OSM) — strict place search, last-resort fallback.
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search

# Google Geocoding endpoint — almost never needs to change.
GOOGLE_GEOCODE_ENDPOINT=https://maps.googleapis.com/maps/api/geocode/json

# ── Country / region biasing ──────────────────
# 2-letter ISO country code used for default biasing of OSM-backed
# providers (Photon / Nominatim) and for Google Places component filter.
# Examples: in, us, au, gb.
COUNTRY_CODE=in
# Bounding-box bias for fuzzy search (Photon). Format:
#   minLon,minLat,maxLon,maxLat
# Default covers India. Override for other regions.
COUNTRY_BBOX=68,7,98,38

# ── Performance tuning (Phase 1 — deployment-level) ──
# Leave blank or omit to use the safe defaults baked into code.
# Override per environment when load profiles call for it.
#
# Place search (typeahead) in-memory cache:
PLACE_SEARCH_CACHE_TTL_MS=300000      # 5 minutes
PLACE_SEARCH_CACHE_MAX=200            # 200 unique queries
#
# Reverse-geocode cache TTL in DB. Addresses rarely move:
GEOCODE_CACHE_TTL_DAYS=30
#
# Admin impersonation token lifetime. Shorter = safer. Longer = nicer.
IMPERSONATE_TTL_MIN=15
#
# Socket.IO heartbeats. Raise on flaky mobile / VPN networks:
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=60000
# How long after boot to run the stale-online sweep (offlining partners
# whose last session ended without a clean disconnect):
STALE_ONLINE_SWEEP_MS=60000
# Grace before flipping a partner offline after disconnect. Short bursts
# of disconnects (route changes) reconnect within this window:
SOCKET_DISCONNECT_GRACE_MS=4000
#
# Ops digest send time (local hour in IST). Change to 9 if 7 AM is too early.
OPS_DIGEST_HOUR_IST=7
#
# FCM multicast batch size. Firebase caps at 500 — only lower it.
FCM_BATCH_SIZE=500

# ── SMTP (optional — M95 ops digest email) ────
# When all four of SMTP_HOST + SMTP_USER + SMTP_PASS + OPS_EMAIL are
# set, the daily ops digest is emailed. Otherwise the markdown is
# logged to stdout only (still observable via GET /admin/ops-digest).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OPS_EMAIL=

# ── Cloudinary (image uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
